{
  "name": "nhost-retro",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "12.3.4"
  },
  "scripts": {
    "dev": "pnpm --filter @retro/frontend dev",
    "local:apply": "node scripts/apply-local.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "test:target": "node scripts/test-target.ts",
    "test:backend": "node scripts/run-backend.ts",
    "test:e2e": "node scripts/run-e2e.ts",
    "test:migrations": "node scripts/run-migrations.ts",
    "test:browsers": "pnpm --filter @retro/frontend exec playwright install chromium",
    "facilitator": "node scripts/facilitator.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11"
  },
  "type": "module"
}
