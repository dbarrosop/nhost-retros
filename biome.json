{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "files": {
    "includes": [
      "package.json",
      "biome.json",
      "frontend/**",
      "!frontend/dist",
      "!frontend/node_modules",
      "!frontend/test-results",
      "!frontend/playwright-report",
      "scripts/**",
      "backend/tests/**",
      "!backend/tests/node_modules"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
