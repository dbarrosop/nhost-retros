# Public browser configuration only. Never put secrets in VITE_* variables.
# The SDK derives all service URLs from the project subdomain and region.
# Use your cloud project's values when deploying; these defaults select local Nhost.
VITE_NHOST_SUBDOMAIN=local
VITE_NHOST_REGION=local

# Optional overrides for custom endpoints or isolated dual-engine acceptance.
# Leave unset for normal local/cloud projects. Overrides take precedence above.
# VITE_NHOST_AUTH_URL=https://local.auth.local.nhost.run/v1
# VITE_NHOST_GRAPHQL_URL=https://local.graphql.local.nhost.run/v1
